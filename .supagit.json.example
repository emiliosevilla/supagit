{
  "remote": "origin",
  "branches": {
    "dev": null,
    "pre": null,
    "prod": null
  },
  "branch_aliases": {
    "dev": ["dev", "develop", "development", "desarrollo", "work"],
    "pre": ["pre", "preview", "staging", "stage", "qa", "beta"],
    "prod": ["prod", "production", "produccion", "real", "live"]
  },
  "backend": {
    "provider": "supabase",
    "cli": "supabase",
    "auto_detect": true,
    "environments": {
      "pre": {
        "project_ref_env": "SUPABASE_PRE_PROJECT_REF"
      },
      "prod": {
        "project_ref_env": "SUPABASE_PROD_PROJECT_REF"
      }
    }
  },
  "checks": [],
  "sweep": {
    "pr_merge_method": "merge",
    "require_gh": true
  }
}
